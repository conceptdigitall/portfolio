# Supabase (mesmo projeto usado pelo wacrm)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FINANCEIRO_ACCOUNT_ID=your-account-id
FINANCEIRO_PIPELINE_NAME=Financeiro

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-opus-5

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://your-evolution-instance.example.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=your-instance-name

# Numero (E.164 sem o "+") para onde a mensagem sera enviada
NOTIFY_WHATSAPP_NUMBER=5511999999999
